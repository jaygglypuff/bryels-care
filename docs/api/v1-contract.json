{
  "api": "/api/v1",
  "conventions": {
    "envelope": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
        },
        "siteId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "clientCreatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "payload": {
          "type": "object",
          "properties": {},
          "additionalProperties": {}
        }
      },
      "required": [
        "commandId",
        "siteId",
        "payload"
      ],
      "additionalProperties": false
    },
    "idempotencyHeader": "Idempotency-Key (UUID); required on every command marked idempotent; a repeat returns the stored response; same key with a different body or user → 422 IDEMPOTENCY_KEY_REUSED",
    "correlationHeader": "X-Request-Id (accepted or generated, echoed)",
    "success": "{ ok: true, data }",
    "error": "{ ok: false, error: { code, message, details } }",
    "versioning": "breaking changes create /api/v2 routes"
  },
  "commands": [
    {
      "name": "inventory.movement.transfer",
      "method": "POST",
      "path": "/api/v1/inventory/movements/transfer",
      "summary": "Move a quantity of one lot between two locations of its site (scan-to-move).",
      "permission": "inventory.movement.post",
      "idempotent": true,
      "offline": "queueable",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "lotId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "fromLocationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "toLocationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "qty": {
            "type": "string",
            "pattern": "^\\d{1,12}(\\.\\d{1,6})?$"
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        },
        "required": [
          "lotId",
          "fromLocationId",
          "toLocationId",
          "qty",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "inventory.movement.reverse",
      "method": "POST",
      "path": "/api/v1/inventory/movements/reverse",
      "summary": "Reverse a posted movement with a reason, optionally posting a corrected replacement transfer.",
      "permission": "inventory.movement.void",
      "idempotent": true,
      "offline": "online_only",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "movementId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "confirmation": {
            "type": "string",
            "minLength": 1
          },
          "replacement": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "fromLocationId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "toLocationId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "qty": {
                    "type": "string",
                    "pattern": "^\\d{1,12}(\\.\\d{1,6})?$"
                  }
                },
                "required": [
                  "fromLocationId",
                  "toLocationId",
                  "qty"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "movementId",
          "reason",
          "confirmation"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "inventory.reconciliation.run",
      "method": "POST",
      "path": "/api/v1/inventory/reconciliation/run",
      "summary": "Enqueue an on-demand ledger reconciliation for the site.",
      "permission": "inventory.balance.admin",
      "idempotent": true,
      "offline": "online_only",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "inventory.balance.rebuild",
      "method": "POST",
      "path": "/api/v1/inventory/balances/rebuild",
      "summary": "Enqueue a projection rebuild from the ledger for the site (optionally the lots of a reconciliation run).",
      "permission": "inventory.balance.admin",
      "idempotent": true,
      "offline": "online_only",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reconciliationRunId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "lotIds": {
            "anyOf": [
              {
                "maxItems": 5000,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "platform.job.retry",
      "method": "POST",
      "path": "/api/v1/platform/jobs/retry",
      "summary": "Put a failed or cancelled background job back in the queue.",
      "permission": "platform.job.admin",
      "idempotent": true,
      "offline": "online_only",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "jobId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "platform.job.cancel",
      "method": "POST",
      "path": "/api/v1/platform/jobs/cancel",
      "summary": "Cancel a queued (or failed) background job.",
      "permission": "platform.job.admin",
      "idempotent": true,
      "offline": "online_only",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "jobId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "platform.notification.acknowledge",
      "method": "POST",
      "path": "/api/v1/platform/notifications/acknowledge",
      "summary": "Acknowledge one of your own notifications.",
      "permission": null,
      "idempotent": true,
      "offline": "queueable",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "notificationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "notificationId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "sales.sales_order.submit",
      "method": "POST",
      "path": "/api/v1/sales/orders/submit",
      "summary": "Submit a draft order: requirements snapshot, MOQ, credit and approval rules; confirmed within limits, else pending approval with the reasons.",
      "permission": "sales.sales_order.submit",
      "idempotent": true,
      "offline": "online_only",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "orderId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "sales.sales_order.approve",
      "method": "POST",
      "path": "/api/v1/sales/orders/approve",
      "summary": "Approve the next step of a pending order (approval rules; the creator or submitter cannot approve while approvals.sod.sales_order is on).",
      "permission": "sales.sales_order.approve",
      "idempotent": true,
      "offline": "online_only",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "orderId"
        ],
        "additionalProperties": false
      }
    }
  ],
  "queries": [
    {
      "name": "inventory.availability.list",
      "method": "GET",
      "path": "/api/v1/inventory/availability",
      "summary": "On hand, reserved, allocated, blocked and available per lot and location of a site.",
      "permission": "inventory.balance.view",
      "response": "json",
      "query": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "asOf": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "locationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "itemKind": {
            "type": "string",
            "enum": [
              "material",
              "product"
            ]
          },
          "q": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "siteId"
        ],
        "additionalProperties": false
      }
    },
