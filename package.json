{
  "name": "bryels-care",
  "version": "0.1.0",
  "private": true,
  "description": "Bryel's Care manufacturing ERP + CRM (MVP)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@zxing/library": "0.23.0",
    "decimal.js": "10.6.0",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "0.545.0",
    "next": "15.5.28",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "tsx": "4.21.0",
    "uuidv7": "1.0.2",
    "zod": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
