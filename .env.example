# Local development defaults. The full list of variables per service (web, worker, backup) and their
# production values is in docs/deployment-railway.md §4; Admin → Diagnostics → Variables shows which are set.

# Runtime database (application role)
DATABASE_URL=postgres://postgres@localhost:5432/bryels
# Migration role (falls back to DATABASE_URL when unset)
DATABASE_MIGRATION_URL=
# Public origin used for Origin checks on mutating requests
APP_ORIGIN=http://localhost:3000
# development | staging | production. production refuses demo data and enforces the production checks.
APP_ENV=development
# Fictional demo (ADR-055): demo data, one-click demo sign-in, demo banner, Reset demo data.
# Never on production. ALLOW_DEMO_SEED=true is read as the older name of the same switch.
DEMO_MODE=true
# Which demo DEMO_MODE loads: lite (default; the live demo, one site) or full (every module, all sites;
# the integration tests always use full through tests/support).
DEMO_PROFILE=lite
# 1 = every request except /api/health and /api/ready answers a 503 maintenance page (restores only;
# docs/operations-runbook.md "Before any restore"). Leave unset otherwise.
# MAINTENANCE_MODE=1
# Worker (pnpm worker): parallel deliveries per job queue, and the health/readiness port (Railway sets PORT)
WORKER_CONCURRENCY=2
# PORT=3001

# Email (docs/deployment-railway.md §5): none | outbox (development) | brevo | resend
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# EMAIL_FROM="Bryel's Care <noreply@your-domain>"
