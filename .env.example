# Runtime database (application role)
DATABASE_URL=postgres://postgres@localhost:5432/bryels
# Migration role (falls back to DATABASE_URL when unset)
DATABASE_MIGRATION_URL=
# Public origin used for Origin checks on mutating requests
APP_ORIGIN=http://localhost:3000
# Set to "true" only on development/staging to allow the fictional demo seed
ALLOW_DEMO_SEED=true
# Worker (pnpm worker): parallel deliveries per job queue, and the health/readiness port (Railway sets PORT)
WORKER_CONCURRENCY=2
# PORT=3001
